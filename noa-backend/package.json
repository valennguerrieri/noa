{
  "name": "noa-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild",
    "empaquetar": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "App de escritorio NOA",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.valentina.noa",
    "productName": "NOA",
    "directories": {
      "output": "release/"
    },
    "files": [
      "**/*",
      {
        "from": "../noa-frontend/dist/noa/browser",
        "to": "frontend-dist"
      }
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "noa-avatar.ico",
      "artifactName": "NOA Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
